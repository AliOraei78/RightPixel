# Local access stays on loopback. Public hosting requires HTTPS and Production.
RIGHTPIXEL_ENVIRONMENT=Development
RIGHTPIXEL_PORT=8085
POSTGRES_PASSWORD=generate-a-long-random-app-password
POSTGRES_ADMIN_PASSWORD=generate-a-different-random-migration-password
# Base64 of at least 32 cryptographically random bytes.
AUTH_CODE_KEY=generate-base64-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=RightPixel
