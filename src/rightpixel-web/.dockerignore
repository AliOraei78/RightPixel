# Only frontend build inputs belong in this context.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!index.html
!nginx.conf
!src/
!src/**
!public/
!public/**

# Exclude local files even inside an allowed source directory.
**/.git
**/.vs
**/.idea
**/.codex
**/node_modules
**/dist
**/.cache
**/.vite
**/.env
**/.env.*
**/secrets.json
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/*.tsbuildinfo
**/*.log
**/*.tmp
**/*.temp
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
